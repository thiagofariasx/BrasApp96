# Copie para .env (uso local: npm run setup / npm run reset-admin / npm run dev). NÃO suba o .env no GitHub.
# OBRIGATÓRIA: conteúdo INTEIRO do JSON da Service Account, numa linha só (ou em base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opcionais (já têm padrão automático):
# SPREADSHEET_ID=1zO1I7Us_9ZNjmHXJoIeN38ikDTNuFQ13-dBLYItPz9c
# BRASERO_SEGREDO_SESSAO=   (padrão: derivado da chave da Service Account)
# BRASERO_FIN_INICIO=       (padrão: data de criação do primeiro usuário = mesma lógica do Apps Script)
